      { "kind": "실제", "spoken": "그럼 모든 행렬이 대각화가 될까요", "after": "누가 한번 대답해 볼까요", "upto": 21, "real": true },
      { "kind": "실제", "spoken": "람다가 2일 때 고유벡터는 뭘까요", "after": "", "upto": 14, "real": true },
      { "kind": "실제", "spoken": "이 행렬의 행렬식은 얼마일까요", "after": "직접 계산해 보세요", "upto": 9, "real": true },
      { "kind": "실제", "spoken": "고윳값이 0이면 어떻게 될까요", "after": "한번 생각해 볼까요", "upto": 8, "real": true },
