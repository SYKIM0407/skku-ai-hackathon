      { "kind": "실제", "spoken": "특성방정식의 차수는 뭘까요", "after": "", "upto": 10, "real": true },
      { "kind": "실제", "spoken": "대각화하면 뭐가 좋을까요", "after": "자유롭게 적어 보세요", "upto": 20, "real": true },
      { "kind": "실제", "spoken": "고유벡터에 2를 곱해도 고유벡터일까요", "after": "맞으면 예 아니면 아니요로 답해 주세요", "upto": 16, "real": true },
      { "kind": "실제", "spoken": "단위행렬의 고윳값은 뭘까요", "after": "", "upto": 10, "real": true },
