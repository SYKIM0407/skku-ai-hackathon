      { "kind": "실제", "spoken": "A의 세제곱은 어떻게 구할까요", "after": "잠깐 고민해 보세요", "upto": 21, "real": true },
      { "kind": "실제", "spoken": "고윳값 2에 대응하는 고유벡터를 누가 말해 볼까요", "after": "", "upto": 14, "real": true },
      { "kind": "실제", "spoken": "영벡터는 고유벡터가 될 수 있을까요", "after": "생각해 보세요", "upto": 3, "real": true },

      { "kind": "수사적", "spoken": "왜 0으로 놓을까요", "after": "그건 바로 0이 아닌 해가 존재해야 하기 때문이에요", "upto": 5, "real": false },
