      { "kind": "수사적", "spoken": "그럼 P는 뭘까요", "after": "고유벡터를 열로 세운 행렬이에요", "upto": 18, "real": false },
      { "kind": "수사적", "spoken": "어떻게 될까요", "after": "네 대각행렬이 됩니다", "upto": 18, "real": false },
      { "kind": "수사적", "spoken": "그럼 람다가 5일 때는요", "after": "똑같이 하면 됩니다", "upto": 16, "real": false },
      { "kind": "수사적", "spoken": "이게 무슨 뜻일까요", "after": "즉 해가 무수히 많다는 뜻이에요", "upto": 7, "real": false },
      { "kind": "수사적", "spoken": "행렬식이 0이 아니면 어떻게 될까요", "after": "그럼 해가 0밖에 없어요", "upto": 6, "real": false },
      { "kind": "수사적", "spoken": "그럼 D의 대각선에는 뭐가 올까요", "after": "바로 고윳값들이 옵니다", "upto": 19, "real": false },
      { "kind": "수사적", "spoken": "왜 열로 세울까요", "after": "AP를 계산해 보면 이유가 보여요", "upto": 18, "real": false },
      { "kind": "수사적", "spoken": "몇 개가 나올까요", "after": "2 곱하기 2니까 최대 두 개예요", "upto": 9, "real": false },
      { "kind": "수사적", "spoken": "왜 그럴까요", "after": "고유벡터가 서로 독립이어야 하기 때문입니다", "upto": 24, "real": false },

      { "kind": "일반", "spoken": "이 식을 특성방정식이라고 불러요", "after": "예제로 2 곱하기 2 행렬 하나를 볼게요", "upto": 7, "real": false },
      { "kind": "일반", "spoken": "다음 시간에는 대각화가 안 되는 경우를 살펴볼게요", "after": "", "upto": 24, "real": false },
      { "kind": "일반", "spoken": "이건 시험에 나와요", "after": "꼭 기억해 두세요", "upto": 20, "real": false },
      { "kind": "일반", "spoken": "필기 안 하셔도 돼요 자료 올려 드릴게요", "after": "", "upto": 12, "real": false },
      { "kind": "일반", "spoken": "잠깐 쉬었다가 할까요", "after": "5분 쉬고 다시 시작할게요", "upto": 12, "real": false },
      { "kind": "일반", "spoken": "출석 부를게요", "after": "", "upto": 1, "real": false },
      { "kind": "일반", "spoken": "람다가 2와 5가 나옵니다", "after": "", "upto": 9, "real": false },
      { "kind": "일반", "spoken": "과제는 다음 주 화요일까지예요", "after": "", "upto": 25, "real": false },
      { "kind": "일반", "spoken": "그럼 시작해 볼까요", "after": "오늘은 고윳값과 고유벡터를 배워 볼게요", "upto": 1, "real": false },
      { "kind": "일반", "spoken": "다들 들리시죠", "after": "네 좋아요 시작할게요", "upto": 1, "real": false }
